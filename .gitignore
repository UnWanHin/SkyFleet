__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# 仿真产物：体积大、可由命令完整重建，不入库。
# 但指标文本与 SVG 矢量图入库——它们是报告直接引用的交付物。
out/logs/*.jsonl
out/figures/**/*.png
out/replay/*.html

# 标定实验的逐次日志：每轮数万条事件，9 轮合计约 1.5 GB。
# 它们可由 `study --spec` 完整重建，且 csv 汇总已含全部指标，
# 因此只入库 spec.json / runs.csv / summary.md 三样。
out/study/**/logs/

# 临时草稿目录（探针、一次性转换、图表试作），不是产物
.build/
